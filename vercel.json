{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["public/**", "data/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/client-terms(\\.html)?",
      "dest": "/public/client-terms.html"
    },
    {
      "src": "/vendor-terms(\\.html)?",
      "dest": "/public/vendor-terms.html"
    },
    {
      "src": "/properties(\\.html)?",
      "dest": "/public/properties.html"
    },
    {
      "src": "/request-service(\\.html)?",
      "dest": "/public/request-service.html"
    },
    {
      "src": "/become-vendor(\\.html)?",
      "dest": "/public/become-vendor.html"
    },
    {
      "src": "/about(\\.html)?",
      "dest": "/public/about.html"
    },
    {
      "src": "/contact(\\.html)?",
      "dest": "/public/contact.html"
    },
    {
      "src": "/admin(\\.html)?",
      "dest": "/public/admin.html"
    },
    {
      "src": "/privacy-policy(\\.html)?",
      "dest": "/public/privacy-policy.html"
    },
    {
      "src": "/disclaimer(\\.html)?",
      "dest": "/public/disclaimer.html"
    },
    {
      "src": "/css/(.*)",
      "dest": "/public/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/public/js/$1"
    },
    {
      "src": "/(allfix-xpress-green\\.png|favicon\\.png|robots\\.txt)",
      "dest": "/public/$1"
    },
    {
      "src": "/$",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
