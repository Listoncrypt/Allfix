# ==============================================================================
# ALLFIX Services Xpress — Environment Configuration
# ==============================================================================

# Server Port (default 3000)
PORT=3000

# Admin Portal Security Credentials
ADMIN_USERNAME=admintony
ADMIN_PASSWORD=your_secure_password_here
ADMIN_SESSION_SECRET=

# Supabase server credentials (service-role key stays on the API server only)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Email OTP (Resend) — sender must belong to a verified domain
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OTP_SESSION_SECRET=
